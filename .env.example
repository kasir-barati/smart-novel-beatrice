PORT=3000
SERVICE_NAME=smart-novel-beatrice
# INSTANCE_ID=  # Identifies this replica in logs; defaults to the hostname (e.g. pod name in k8s).
GENERATE_AUDIO__MAX_TEXT_LENGTH=4000
# Comma-separated hosts genUploadUrl/statusCallbackUrl are allowed to point at. "localhost" lets you exercise the happy path manually without a real callback receiver, the "queued" callback POST is best-effort and won't fail the mutation. "presign-server" is the local compose stack's stand-in for a client-owned callback host.
GENERATE_AUDIO__CALLBACK__ALLOWED_HOSTS=presign-server,localhost

# -- Logging ----------------------------------------------------------------- #
LOGGING__MODE=JSON # JSON | PLAIN_TEXT
LOGGING__LEVEL=info

# -- OpenTelemetry ----------------------------------------------------------- #
OTEL__ENABLED=true
OTEL__EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL__TRACES_SAMPLER=parentbased_always_on

# -- Model backend (OpenAI-compatible endpoint) ------------------------------ #
LLM__BASE_URL=http://ollama:11434/v1
LLM__API_KEY=ollama # Ollama accepts any non-empty string; real providers need a real key
LLM__MODEL=qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b # Build-time pull for the ollama compose service. Keep in sync with LLM__MODEL.
LLM__TIMEOUT_MS=180000

# --------------------------------------------------------------------------- #
# Per-endpoint overrides (optional; leave unset to use LLM__* defaults above).
# --------------------------------------------------------------------------- #
# EXPLAIN_WORD__MODEL=
EXPLAIN_WORD__TEMPERATURE=0
# NORMALIZE_TTS__MODEL=
NORMALIZE_TTS__TEMPERATURE=0
# NORMALIZE_TTS__MAX_LENGTH_DEVIATION=0.3

# -- TTS provider abstraction ------------------------------------------------ #
# TTS__OUTPUT_DIR=/tmp/beatrice-audio
# TTS__DEFAULT_PROVIDER=qwen3-tts # qwen3-tts | gemini-tts
# Local compose stack points at the qwen-tts shim; use https://dashscope-intl.aliyuncs.com for real DashScope.
TTS__QWEN__BASE_URL=http://qwen-tts:8001
TTS__QWEN__API_KEY=
# TTS__QWEN__MODEL=qwen3-tts-instruct-flash
# Comma-separated static voice names — DashScope has no voices-listing endpoint. Matches the qwen-tts shim's `_VOICES` mapping (local-setup/qwen-tts/server.py).
TTS__QWEN__VOICES=default
# CustomVoice CPU inference is slow enough locally to exceed the 30s client default — 120s still wasn't enough for a few hundred characters of text, so this is generous.
TTS__QWEN__TIMEOUT_MS=300000
# TTS__GEMINI__BASE_URL=https://texttospeech.googleapis.com
# TTS__GEMINI__API_KEY=
# TTS__GEMINI__VOICES_PATH=/v1/voices
# TTS__GEMINI__TIMEOUT_MS=30000

# -- RabbitMQ ------------------------------------------------------------------ #
RABBITMQ__CONNECTION_STRING=amqp://guest:guest@rabbitmq:5672/
# RABBITMQ__QUEUE_NAME=beatrice.generate_audio
# RABBITMQ__PREFETCH_COUNT=5
# RABBITMQ__DLQ_NAME=beatrice.generate_audio.dlq
# RABBITMQ__DELIVERY_LIMIT=3
# RABBITMQ__RETRY_DELAY_SECONDS=30
# RABBITMQ__WORKER_ENABLED=true

# MinIO's host-side port only (internal traffic still uses minio:9000). Defaults off
# 9000 since that's a common local-tooling default (e.g. Jupyter); override if needed.
# MINIO_HOST_PORT=9010

# JN
OPENAI_API_KEY=sk-proj-asd
OPENROUTER_API_KEY=sk-or-v1-asd
